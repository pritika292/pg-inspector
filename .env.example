# Copy to .env and fill in real values for local development.
# .env is gitignored; .env.example is committed.

# Port the server listens on
PORT=3014

# Environment label: development | test | production
NODE_ENV=development

# Read-only Postgres role used by the HTTP server
DATABASE_URL=postgres://pg_inspector:devpass@localhost:5432/pg_scenarios

# Admin Postgres role used ONLY by the boot-time migrator + seeder.
# The HTTP server never reads this — separation enforced in services/db/.
ADMIN_DATABASE_URL=postgres://pg_inspector:devpass@localhost:5432/pg_scenarios

# Redis logical DB 13
REDIS_URL=redis://localhost:6379/13

# OpenAI key for NL→SQL, EXPLAIN-AI, and advise. Boot guard rejects this
# placeholder in production; set the real key via Azure Key Vault on prod.
OPENAI_API_KEY=sk-replace-me-with-real-key

# Logging
LOG_LEVEL=info
