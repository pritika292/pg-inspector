{
  "name": "pg-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite -c build/vite.config.ts",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "vite build -c build/vite.config.ts",
    "build": "npm run build:server && npm run build:client",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/db/migrate.ts",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run -c build/vitest.config.ts",
    "test:watch": "vitest -c build/vitest.config.ts"
  },
  "prettier": {
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@faker-js/faker": "^10.4.0",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "openai": "^6.39.0",
    "pg": "^8.21.0",
    "pg-format": "^1.0.4",
    "pgsql-ast-parser": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/pg-format": "^1.0.5",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.4"
  }
}
